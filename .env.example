# Copy this file to .env (or .env.local) and fill in real values.
# Nothing in this file is a real secret — it's a template.

# Public site URL — used for SEO metadata, sitemap.xml, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.neweraacademy.org

# --- Email delivery (SMTP via Nodemailer) ---------------------------------
# TODO(NEA): supply real SMTP credentials. Until SMTP_HOST is set, form
# submissions are validated normally but only logged to the server console
# instead of emailed — see src/lib/mailer.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# The inbox that receives contact, tour-request, and career-application
# emails. REQUIRED: if this is unset, the three form API routes fail closed
# (generic error to the visitor, real reason logged server-side) instead of
# falling back to any hardcoded address.
CONTACT_FORM_RECIPIENT_EMAIL=

# Address emails are sent "from". Should be a verified sender/domain for
# your SMTP provider.
MAIL_FROM=no-reply@neweraacademy.org
